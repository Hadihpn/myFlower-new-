<style>
  @media (min-width: 992px) {
    .register-page-wrapper {
      min-height: 100vh;
      background-image:
        linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)),
        url('/uploads/desktop/plant/plant-banner-desktop.png');
    }
  }
.register-page-wrapper{
  min-height:100vh;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:20px;
  background-image:
    linear-gradient(rgba(0,0,0,.45), rgba(0,0,0,.45)),
    url('/uploads/desktop/plant/plant-banner-desktop.png');
  background-size:cover;
  background-position:center;
}

/* کارت شیشه ای */
.glass-card{
  width:100%;
  max-width:420px;
  padding:35px;
  border-radius:20px;
  backdrop-filter:blur(15px);
  -webkit-backdrop-filter:blur(15px);
  background:rgba(255,255,255,.08);
  border:1px solid rgba(255,255,255,.2);
  box-shadow:0 10px 40px rgba(0,0,0,.3);
}

.glass-card input{
  color:white;
}

.glass-card input::placeholder{
  color:rgba(255,255,255,.7);
}
</style>

<div class="register-page-wrapper">

  <div class="glass-card">
    <div class="text-center mb-4">
      <h3 class="fw-bold text-light">ثبت نام</h3>
    </div>

    <form method="POST" action="/api/auth/register">

      <div class="mb-3">
        <input
          type="text"
          name="fullName"
          value=""
          class="form-control bg-transparent border-light"
          placeholder="نام کامل"
          required
        >
      </div>

      <div class="mb-3">
        <input
          type="email"
          name="email"
          value=""
          class="form-control bg-transparent border-light"
          placeholder="ایمیل"
          required
        >
      </div>

      <div class="mb-3">
        <input
          type="tel"
          name="phoneNumber"
          value=""
          class="form-control bg-transparent border-light"
          placeholder="شماره موبایل"
          required
        >
      </div>

      <div class="mb-4">
        <input
          type="password"
          name="password"
          class="form-control bg-transparent border-light"
          placeholder="رمز عبور"
          required
        >
      </div>

      

      <button class="btn btn-success w-100 rounded-pill py-2">
        ثبت نام
      </button>

    </form>
  </div>

</div>
<div class="text-center mt-3">
  <a href="/login" class="text-light">حساب دارید؟ وارد شوید</a>
</div>