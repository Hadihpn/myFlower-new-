<div class="container-fluid py-4">
  <!-- HEADER -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h4 class="mb-1">سلام <%= user?.fullName || "کاربر" %> 👋</h4>
      <small class="text-muted">به پنل مدیریت گیاهان خوش آمدید</small>
    </div>
  </div>

  <!-- SUMMARY CARDS -->
  <div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
      <div class="card-dash text-center">
        <div class="mb-2">🌱</div>
        <h6>گیاهان</h6>
        <h4 id="plants-count">0</h4>
      </div>
    </div>

    <div class="col-6 col-lg-3">
      <div class="card-dash text-center">
        <div class="mb-2">📟</div>
        <h6>دستگاه‌ها</h6>
        <h4 id="devices-count">0</h4>
      </div>
    </div>

    <div class="col-6 col-lg-3">
      <div class="card-dash text-center">
        <div class="mb-2">✅</div>
        <h6>تسک امروز</h6>
        <h4 id="tasks-count">0</h4>
      </div>
    </div>
  </div>

  <!-- MAIN GRID: Plants + Tasks -->
  <div class="row g-4 mb-4">
    <!-- PLANTS -->
    <div class="col-12 col-lg-8">
      <div class="card-dash h-100">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h5 class="mb-0">گیاهان من</h5>
          <button class="btn btn-sm btn-success">افزودن</button>
        </div>
        <div class="row g-3" id="plants-container"></div>
      </div>
    </div>

    <!-- TASKS -->
    <div class="col-12 col-lg-4">
      <div class="card-dash h-100">
        <h5 class="mb-3">کارهای امروز</h5>
        <ul class="list-group list-group-flush" id="tasks-list"></ul>
      </div>
    </div>
  </div>

  <!-- SENSOR CHART -->
  <div class="row">
    <div class="col-12">
      <div class="card-dash">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
          <h5 class="mb-0">وضعیت سنسورها (۷ روز اخیر)</h5>
          <button
            class="btn btn-sm btn-outline-success"
            type="button"
            onclick="resetSensorChartZoom()"
          >
            ریست زوم
          </button>
        </div>

        <div class="chart-wrapper">
          <canvas id="sensorChart"></canvas>
        </div>

        <small class="text-muted d-block mt-2">
          روی موبایل با دو انگشت زوم کنید و برای جابجایی، نمودار را به چپ و راست بکشید.
        </small>
      </div>
    </div>
  </div>
</div>

<style>
  .chart-wrapper {
    position: relative;
    width: 100%;
    height: 360px;
  }

  @media (max-width: 768px) {
    .chart-wrapper {
      height: 280px;
    }
  }

  #plants-container img {
    width: 100%;
    height: 140px;
    object-fit: cover;
  }
</style>

<!-- ترتیب درست -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/hammerjs"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-zoom@2.0.1"></script>

<script>
  let sensorChartInstance = null;

  async function loadDashboard() {
    try {
      const res = await fetch('/api/getDashboardData', {
        credentials: 'include',
      });

      if (!res.ok) {
        throw new Error('خطا در دریافت اطلاعات داشبورد');
      }

      const data = await res.json();

      renderSummary(data);
      renderPlants(data.plants || []);
      renderTasks(data.todayTasks || []);
      renderChart(data.devices || []);
    } catch (error) {
      console.error('Dashboard load error:', error);
    }
  }

  function renderSummary(data) {
    document.getElementById('plants-count').innerText = (data.plants || []).length;
    document.getElementById('devices-count').innerText = data.deviceCount || 0;
    document.getElementById('tasks-count').innerText = (data.todayTasks || []).length;
  }

  function renderPlants(plants) {
    const container = document.getElementById('plants-container');
    container.innerHTML = '';

    if (!plants.length) {
      container.innerHTML = `
        <div class="col-12">
          <div class="text-muted text-center py-4">هنوز گیاهی ثبت نشده است.</div>
        </div>
      `;
      return;
    }

    plants.forEach((p) => {
      const html = `
        <div class="col-6 col-lg-3">
          <div class="p-3 border rounded bg-white h-100">
            <img
              src="${p.imageUrl || 'https://via.placeholder.com/300x200?text=Plant'}"
              alt="${p.name || 'plant'}"
              class="img-fluid rounded mb-2"
            >
            <h6 class="mb-0">${p.name || 'بدون نام'}</h6>
          </div>
        </div>
      `;

      container.innerHTML += html;
    });
  }

  function renderTasks(tasks) {
    const list = document.getElementById('tasks-list');
    list.innerHTML = '';

    if (!tasks.length) {
      list.innerHTML = `
        <li class="list-group-item text-muted">امروز کاری ثبت نشده است.</li>
      `;
      return;
    }

    tasks.forEach((t) => {
      const li = document.createElement('li');
      li.className = 'list-group-item d-flex align-items-center';

      li.innerHTML = `
        <input type="checkbox" class="form-check-input me-2">
        <span>${t.taskType || 'تسک'}</span>
      `;

      list.appendChild(li);
    });
  }

  function renderChart(devices) {
    const ctx = document.getElementById('sensorChart');
    const chartData = buildChartData(devices);

    if (!chartData) {
      if (sensorChartInstance) {
        sensorChartInstance.destroy();
        sensorChartInstance = null;
      }

      const wrapper = document.querySelector('.chart-wrapper');
      wrapper.innerHTML = `
        <div class="d-flex align-items-center justify-content-center h-100 text-muted">
          داده‌ای برای نمایش نمودار وجود ندارد.
        </div>
      `;
      return;
    }

    // اگر قبلاً chart ساخته شده، destroy کن
    if (sensorChartInstance) {
      sensorChartInstance.destroy();
    }

    sensorChartInstance = new Chart(ctx, {
      type: 'line',
      data: chartData,
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: {
          mode: 'index',
          intersect: false,
        },
        elements: {
          point: {
            radius: 0,
            hoverRadius: 4,
            hitRadius: 12,
          },
          line: {
            borderWidth: 2,
          },
        },
        scales: {
          x: {
            ticks: {
              maxTicksLimit: window.innerWidth < 768 ? 5 : 10,
              maxRotation: 0,
              autoSkip: true,
            },
          },
          y: {
            beginAtZero: false,
            ticks: {
              maxTicksLimit: 6,
            },
          },
        },
        plugins: {
          legend: {
            position: 'bottom',
            labels: {
              boxWidth: 12,
              usePointStyle: true,
            },
          },
          tooltip: {
            mode: 'index',
            intersect: false,
          },
          zoom: {
            limits: {
              x: {
                min: 0,
                max: chartData.labels.length - 1,
                minRange: 3,
              },
            },
            pan: {
              enabled: true,
              mode: 'x',
              threshold: 10,
            },
            zoom: {
              wheel: {
                enabled: true,
              },
              pinch: {
                enabled: true,
              },
              drag: {
                enabled: true,
                backgroColor: 'rgba(32, 201, 151, 0.12)',
                borderColor: '#20c997',
                borderWidth: 1,
              },
              mode: 'x',
            },
          },
        },
      },
    });

    window.sensorChart = sensorChartInstance;
  }

  function resetSensorChartZoom() {
    if (window.sensorChart) {
      window.sensorChart.resetZoom();
    }
  }

  const DEVICE_COLORS = ['#20c997', '#ff6384', '#36a2eb', '#ffce56', '#9966ff'];

  function buildChartData(devices) {
    if (!devices || !devices.length) return null;

    const firstDevice = devices.find(
      (device) => Array.isArray(device.latestReadings) && device.latestReadings.length
    );

    if (!firstDevice) return null;

    const labels = [...firstDevice.latestReadings]
      .reverse()
      .map((r) =>
        new Date(r.timestamp).toLocaleDateString('fa-IR', {
          month: 'short',
          day: 'numeric',
        })
      );

    const datasets = [];

    devices.forEach((device, i) => {
      if (!Array.isArray(device.latestReadings) || !device.latestReadings.length) return;

      const color = DEVICE_COLORS[i % DEVICE_COLORS.length];
      const readings = [...device.latestReadings].reverse();

      datasets.push({
        label: `${device.name} - Humidity`,
        data: readings.map((r) => r.humidity),
        borderColor: color,
        backgroundColor: color + '33',
        tension: 0.35,
        fill: false,
      });

      datasets.push({
        label: `${device.name} - Temperature`,
        data: readings.map((r) => r.temperature),
        borderColor: color,
        borderDash: [6, 6],
        tension: 0.35,
        fill: false,
      });
    });

    if (!datasets.length) return null;

    return { labels, datasets };
  }

  loadDashboard();
</script>
